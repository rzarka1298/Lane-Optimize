<?xml version="1.0" encoding="UTF-8"?>
<!--
  RUSH scenario: all traffic spawned dynamically by the env via TraCI
  (see laneiq/env/highway_env.py:_maybe_spawn_ahead). This file only
  declares the route the env uses for vehicle.add(...). NO Poisson
  flows — so vehicles never appear/disappear at the fixed x=0/x=1000
  endpoints in front of the camera.

  Background vehicles spawn ~300 m ahead of the ego (off-screen of
  the follow-camera) and despawn ~250 m behind it. The result: the
  road feels alive but vehicles only enter and leave the visible
  window at its edges, in the direction the ego is moving.

  Paired with:
    - env raises the lane speed limit to 50 m/s in reset()
    - env tunes ego Krauss params (tau=0.4, minGap=1, accel=4) so
      it follows tight + accelerates hard
    - env re-enables SUMO's lcSpeedGain so the ego autonomously
      seeks faster lanes
-->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <route id="r_through" edges="e1"/>

</routes>
