<?xml version="1.0" encoding="UTF-8"?>
<!--
  RUSH scenario: a high-speed weaving showcase.

  The env raises the lane speed limit to 50 m/s at reset() (see
  laneiq/env/highway_env.py). The ego vType (maxSpeed 50) can then
  outrun every background vehicle, which stay capped at their own
  maxSpeeds:

    aggressive 40 m/s · normal 33.33 m/s · slow 25 m/s · ego 50 m/s

  So the ego is uniquely the fastest car on the road. This route
  file supplies a steady, all-lanes traffic stream (the standard
  60/25/15 normal/aggressive/slow mix) at a medium-high rate — busy
  enough that the ego must continuously weave to maintain its speed
  advantage, but not so dense that the road gridlocks.

  Total arrival rate ~0.92 veh/s. Born out of the Week-8 request for
  a demo that shows the agent threading high-speed through traffic;
  the gauntlet (LESSONS #15) handles the start-stuck case, rush
  handles the outrun-everyone case.
-->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <route id="r_through" edges="e1"/>

    <flow id="f_normal"     type="normal"     route="r_through"
          begin="0" end="3600" period="exp(0.55)"
          departLane="best" departSpeed="desired"/>

    <flow id="f_aggressive" type="aggressive" route="r_through"
          begin="0" end="3600" period="exp(0.23)"
          departLane="best" departSpeed="desired"/>

    <flow id="f_slow"       type="slow"       route="r_through"
          begin="0" end="3600" period="exp(0.14)"
          departLane="0"    departSpeed="desired"/>

</routes>
